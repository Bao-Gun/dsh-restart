node_modules/
__pycache__/
.venv/
dist/
build/
# 构建产物：lib 下只有 *.js 进 git —— 索引源按 commit 安装，装完就得能跑，
# 不能在装的人机器上先装 devDependencies 再构建。sourcemap 不进 git。
/lib/*
!/lib/*.js
.env
.env.*
*.local
.DS_Store

# agent 的草稿、计划、临时分析，不进 git
.work/

# superpowers 的临时 mockup（.superpowers/sdd/ 会自己忽略）
.superpowers/brainstorm/

# 并行开发的工作树（using-git-worktrees 要求它必须已忽略）
.worktrees/
