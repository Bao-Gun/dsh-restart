{
  "name": "dsh-restart",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "给 dsh web 加「重启 + 重启前预检」按钮的 DSH 插件",
  "engines": {
    "node": ">=22"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "jsdom": "^31.0.1",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
